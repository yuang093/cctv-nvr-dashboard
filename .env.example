# Avigilon 開發者金鑰
# 取得方式：向 Avigilon Developer Program 申請
# （每個金鑰需綁定 ACC 伺服器的 IP）

# === 必填 ===
AVIGILON_USER_NONCE=your_user_nonce_here
AVIGILON_USER_KEY=your_user_key_here

# === 選填 ===
# 若無 integrationId 可整行刪除或留空
AVIGILON_INTEGRATION_ID=

# === 選填：覆寫 nvr_config.json 的 NVR 帳密 ===
# 若不填則使用 nvr_config.json 中第一台 enabled NVR 的 username/password
# AVIGILON_USERNAME=override_user
# AVIGILON_PASSWORD=override_pass
